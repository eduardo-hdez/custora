<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-base font-semibold text-gray-900">Distribución de Reservas por Sucursal</h2>
      <p class="text-xs text-gray-500 mt-0.5">Proporción de reservas activas por cada sucursal</p>
    </div>
    <span class="material-icons text-[#2B6398] text-2xl">donut_large</span>
  </div>
  <div class="flex flex-col md:flex-row items-center gap-6">
    <div class="w-full md:w-1/2 flex justify-center">
      <canvas id="chartReservasSucursal" height="250" width="250"
        data-chart='<%- JSON.stringify(reservasPorSucursal || []) %>'></canvas>
    </div>
    <!-- Leyenda -->
    <div class="w-full md:w-1/2">
      <ul id="leyendaSucursal" class="space-y-2 text-sm text-gray-700"></ul>
    </div>
  </div>
</div>